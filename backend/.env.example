# Puerto donde corre el servidor de la API REST
PORT=4000

# Cadena de conexión a PostgreSQL (Prisma)
# Ejemplo local: postgresql://postgres:password@localhost:5432/nido_db?schema=public
# Ejemplo Render/Neon/Supabase: postgresql://usuario:password@ep-host.region.neon.tech/nido_db?sslmode=require
DATABASE_URL="postgresql://usuario:password@localhost:5432/nido_db?schema=public"

# Clave secreta para la firma y verificación de tokens JWT
JWT_SECRET="nido_jwt_super_secret_key_change_in_production_2026"

# Tiempo de expiración del token JWT (ejemplo: 24h, 7d, 3600s)
JWT_EXPIRES_IN="24h"

# URL del frontend para configuración de CORS (sin * en producción)
# Ejemplo local: http://localhost:3000
# Ejemplo Vercel: https://tu-sitio.vercel.app
FRONTEND_URL="http://localhost:3000"
